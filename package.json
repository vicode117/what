{
  "name": "translate-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI translation, translation history, and language training.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @tt/desktop dev",
    "build": "pnpm --filter @tt/desktop build",
    "dist": "pnpm --filter @tt/desktop dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/contracts && tsc --noEmit -p packages/core && pnpm --filter @tt/desktop typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.16.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
